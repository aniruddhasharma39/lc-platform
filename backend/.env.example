# Server Port (Render sets PORT automatically, but you can specify 5001 or 10000)
PORT=5001

# PostgreSQL Database URL (AWS RDS or Render Postgres)
DATABASE_URL="postgresql://username:password@localhost:5432/lc_platform?schema=public"

# JWT Authentication Secrets
JWT_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-key"

# Long Session Durations (e.g. 90d, 180d, 365d)
JWT_EXPIRES_IN="90d"
JWT_REFRESH_EXPIRES_IN="180d"

# Default Admin Credentials (used during database seeding)
DEFAULT_ADMIN_EMAIL="admin@lcgate.in"
DEFAULT_ADMIN_PASSWORD="change-me-in-production"

# Cloudinary Media Storage (for gate photos, evidence, wallpaper uploads)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# 2Factor SMS Gateway (DLT Transactional SMS)
TWOFACTOR_API_KEY="your-2factor-api-key"
TWOFACTOR_SENDER_ID="MIRTHA"
TWOFACTOR_TEMPLATE_NAME="MIRTHA"
TWOFACTOR_PE_ID="1001020445402520904"
DLT_LC_GATE_STATE_TEMPLATE_ID="1077472200042625536"

# =====================================================================
# BREVO EMAIL DELIVERY SERVICE (OTP & Gate State Change Alerts)
# =====================================================================
# Recommended: Brevo REST API v3 (Uses HTTPS port 443, never blocked by cloud firewalls)
# Obtain from: Brevo Dashboard -> Top-Right Menu -> SMTP & API -> API Keys
BREVO_API_KEY="xkeysib-your-brevo-api-key"
BREVO_SENDER_EMAIL="your-verified-brevo-sender@domain.com"
BREVO_SENDER_NAME="Indian Railways LC Platform"

# Alternative / Fallback: Brevo SMTP Relay
# Obtain from: Brevo Dashboard -> Top-Right Menu -> SMTP & API -> SMTP
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-brevo-account-email@domain.com"
SMTP_PASS="xsmtpsib-your-brevo-smtp-key"
SMTP_FROM="\"Indian Railways LC Platform\" <your-verified-brevo-sender@domain.com>"
