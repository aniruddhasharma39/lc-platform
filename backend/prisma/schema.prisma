generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id             Int    @id @default(autoincrement())
  name           String @unique
  users          User[]       @relation("FinalRole")
  requestedUsers User[]       @relation("RequestedRole")
  roleModules    RoleModule[]
}

model User {
  id                  Int       @id @default(autoincrement())
  fullName            String
  mobile              String    @unique
  email               String    @unique
  employeeId          String    @unique
  department          String
  passwordHash        String
  roleId              Int?
  role                Role?     @relation("FinalRole", fields: [roleId], references: [id])
  requestedRoleId     Int?
  requestedRole       Role?     @relation("RequestedRole", fields: [requestedRoleId], references: [id])
  status              String    @default("PENDING") // PENDING, APPROVED, REJECTED, DEACTIVATED
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  mustChangePassword  Boolean   @default(false)
  rejectionReason     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  metadata            String?    // JSON string for dynamic registration fields
  evidences           InstallationEvidence[]
  scopeGroups         ScopeGroupUser[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model Module {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  name        String
  roleModules RoleModule[]
}

model RoleModule {
  id       Int    @id @default(autoincrement())
  roleId   Int
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  moduleId Int
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId])
}

model AppSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model RegistrationForm {
  id        Int      @id @default(autoincrement())
  name      String
  schema    String   // JSON representing fields and sections
  status    String   @default("DRAFT") // DRAFT, LIVE, ARCHIVED
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests  RegistrationRequest[]
}

model RegistrationRequest {
  id              Int               @id @default(autoincrement())
  formId          Int
  form            RegistrationForm  @relation(fields: [formId], references: [id], onDelete: Restrict)
  data            String            // JSON representing submitted values
  status          String            @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedRoleId Int?
  rejectionReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model LCGate {
  id               Int              @id @default(autoincrement())
  name             String?
  lcNumber         String           @unique
  locationName     String
  zone             String?
  division         String?
  latitude         Float?
  longitude        Float?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  masters          MasterUnit[]
  scopeGroups      ScopeGroupGate[]
  deviceRegistries DeviceRegistry[]
}

model MasterUnit {
  id               Int                    @id @default(autoincrement())
  serialNumber     String                 @unique
  masterSequence   Int
  powerSource      String
  gateId           Int
  gate             LCGate                 @relation(fields: [gateId], references: [id], onDelete: Cascade)
  childDevices     ChildDevice[]
  evidences        InstallationEvidence[]
  deviceRegistries DeviceRegistry[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model ChildDevice {
  id               Int                    @id @default(autoincrement())
  serialNumber     String                 @unique
  type             String
  deviceSequence   Int
  masterId         Int
  master           MasterUnit             @relation(fields: [masterId], references: [id], onDelete: Cascade)
  evidences        InstallationEvidence[]
  deviceRegistries DeviceRegistry[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model InstallationEvidence {
  id            Int          @id @default(autoincrement())
  category      String
  imageUrl      String
  latitude      Float?
  longitude     Float?
  userId        Int
  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  masterId      Int
  master        MasterUnit   @relation(fields: [masterId], references: [id], onDelete: Cascade)
  childDeviceId Int?
  childDevice   ChildDevice? @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model OtpVerification {
  id         Int      @id @default(autoincrement())
  identifier String
  type       String   // EMAIL or PHONE
  otp        String
  expiresAt  DateTime
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, type])
}

model ScopeGroup {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  color       String?          @default("#0B3C7A")
  allowSms    Boolean          @default(false)
  parentId    Int?
  parent      ScopeGroup?      @relation("ScopeGroupHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    ScopeGroup[]     @relation("ScopeGroupHierarchy")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  gates       ScopeGroupGate[]
  devices     ScopeGroupDevice[]
  users       ScopeGroupUser[]

  @@index([parentId])
}

model ScopeGroupGate {
  id           Int        @id @default(autoincrement())
  scopeGroupId Int
  scopeGroup   ScopeGroup @relation(fields: [scopeGroupId], references: [id], onDelete: Cascade)
  gateId       Int
  gate         LCGate     @relation(fields: [gateId], references: [id], onDelete: Cascade)

  assignedAt   DateTime   @default(now())

  @@unique([scopeGroupId, gateId])
  @@index([scopeGroupId])
  @@index([gateId])
}

model ScopeGroupDevice {
  id           Int            @id @default(autoincrement())
  scopeGroupId Int
  scopeGroup   ScopeGroup     @relation(fields: [scopeGroupId], references: [id], onDelete: Cascade)
  deviceId     Int
  device       DeviceRegistry @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  assignedAt   DateTime       @default(now())

  @@unique([scopeGroupId, deviceId])
  @@index([scopeGroupId])
  @@index([deviceId])
}

model ScopeGroupUser {
  id           Int        @id @default(autoincrement())
  scopeGroupId Int
  scopeGroup   ScopeGroup @relation(fields: [scopeGroupId], references: [id], onDelete: Cascade)
  userId       Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAt   DateTime   @default(now())

  @@unique([scopeGroupId, userId])
  @@index([scopeGroupId])
  @@index([userId])
}

model DeviceRegistry {
  id              Int          @id @default(autoincrement())
  thingName       String       @unique
  thingArn        String?
  thingTypeName   String?
  deviceType      String       @default("MASTER") // MASTER, SLAVE, SENSOR_UNIT, GATEWAY, etc.
  serialNumber    String?      @unique
  status          String       @default("ACTIVE") // ACTIVE, INACTIVE, PROVISIONED, DECOMMISSIONED, MAINTENANCE

  // Optional associations with LC Platform gate & units
  gateId          Int?
  gate            LCGate?      @relation(fields: [gateId], references: [id], onDelete: SetNull)
  masterId        Int?
  master          MasterUnit?  @relation(fields: [masterId], references: [id], onDelete: SetNull)
  childDeviceId   Int?
  childDevice     ChildDevice? @relation(fields: [childDeviceId], references: [id], onDelete: SetNull)

  // Hardware and manufacturing specifications
  macAddress      String?
  imei            String?
  firmwareVersion String?
  hardwareVersion String?
  dateOfMfg       DateTime?
  manufacturer    String?
  modelNumber     String?
  batchNumber     String?

  // Hardware device metadata requested
  sensors         Json?        // List or map of sensors within (e.g. solar voltage, inclinometer, radar, etc.)
  components      Json?        // List or map of internal hardware components (MCU, modem, relays, batteries)
  attributes      Json?        // AWS IoT Thing attributes
  metadata        Json?        // Additional custom specs or dynamic properties

  telemetries     DeviceTelemetry[]
  scopeGroups     ScopeGroupDevice[]

  lastSeenAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([gateId])
  @@index([masterId])
  @@index([childDeviceId])
  @@index([status])
}

model DeviceTelemetry {
  id               Int             @id @default(autoincrement())
  thingName        String
  topic            String?
  payload          Json
  status           String?         @default("ONLINE")
  receivedAt       DateTime        @default(now())
  deviceRegistryId Int?
  deviceRegistry   DeviceRegistry? @relation(fields: [deviceRegistryId], references: [id], onDelete: Cascade)

  @@index([thingName])
  @@index([receivedAt])
}

model GateStateAlertLog {
  id              Int      @id @default(autoincrement())
  gateId          Int?
  lcNumber        String
  status          String   // OPEN, CLOSED
  recipientMobile String
  recipientName   String?
  scopeGroupId    Int?
  message         String
  provider        String   // AIRTEL, 2FACTOR, SIMULATED
  statusResult    String   // SENT, FAILED, SKIPPED
  details         String?
  sentAt          DateTime @default(now())

  @@index([gateId])
  @@index([lcNumber])
  @@index([sentAt])
}
