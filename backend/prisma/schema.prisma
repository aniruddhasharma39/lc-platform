generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id             Int          @id @default(autoincrement())
  name           String       @unique
  users          User[]       @relation("FinalRole")
  requestedUsers User[]       @relation("RequestedRole")
  roleModules    RoleModule[]
}

model User {
  id                  Int                    @id @default(autoincrement())
  fullName            String
  mobile              String                 @unique
  email               String                 @unique
  employeeId          String                 @unique
  department          String
  passwordHash        String
  roleId              Int?
  role                Role?                  @relation("FinalRole", fields: [roleId], references: [id])
  requestedRoleId     Int?
  requestedRole       Role?                  @relation("RequestedRole", fields: [requestedRoleId], references: [id])
  status              String                 @default("PENDING") // PENDING, APPROVED, REJECTED, DEACTIVATED
  failedLoginAttempts Int                    @default(0)
  lockoutUntil        DateTime?
  mustChangePassword  Boolean                @default(false)
  rejectionReason     String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  metadata            String? // JSON string for dynamic registration fields
  evidences           InstallationEvidence[]

  // Railway organizational hierarchy & designation
  designation         String?
  zone                String?
  division            String?
  stationId           Int?
  station             Station?               @relation(fields: [stationId], references: [id], onDelete: SetNull)
  idCardUrl           String?
  assignedGates       UserGate[]
  approvedRequests    RegistrationRequest[]  @relation("ApprovedRequests")

  // PME and RC Safety & Medical Qualifications
  pmeDate                 DateTime?
  pmeExpiryDate           DateTime?
  pmeCertificateNo        String?
  pmeCertificatePhotoUrl  String?
  rcDate                  DateTime?
  rcExpiryDate            DateTime?
  rcInstitute             String?
  rcCertificatePhotoUrl   String?

  // Roster relations
  assignedRosters     GateDutyRoster[]       @relation("AssignedGateman")
  createdRosters      GateDutyRoster[]       @relation("RosterCreator")

  // Facial Biometrics & Attendance
  isFaceEnrolled       Boolean                @default(false)
  faceId               String?
  faceImageKey         String?
  faceEnrolledAt       DateTime?

  // Firebase Cloud Messaging (FCM) Push Token
  fcmToken             String?
  faceEnrollConfidence Float?
  faceLockoutUntil     DateTime?
  shiftAttendances     ShiftAttendance[]      @relation("UserAttendances")
  approvedAttendances  ShiftAttendance[]      @relation("AttendanceApprover")
  faceReenrollments    FaceReenrollmentRequest[] @relation("UserReenrollments")
  reviewedReenrollments FaceReenrollmentRequest[] @relation("ReenrollmentReviewer")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model Module {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  name        String
  roleModules RoleModule[]
}

model RoleModule {
  id       Int    @id @default(autoincrement())
  roleId   Int
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  moduleId Int
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId])
}

model AppSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model RegistrationForm {
  id        Int      @id @default(autoincrement())
  name      String
  schema    String // JSON representing fields and sections
  status    String   @default("DRAFT") // DRAFT, LIVE, ARCHIVED
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests RegistrationRequest[]
}

model RegistrationRequest {
  id                    Int              @id @default(autoincrement())
  formId                Int
  form                  RegistrationForm @relation(fields: [formId], references: [id], onDelete: Restrict)
  data                  String // JSON representing submitted values
  status                String           @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedRoleId       Int?
  rejectionReason       String?
  department            String?
  designation           String?
  zone                  String?
  division              String?
  stationId             Int?
  station               Station?         @relation(fields: [stationId], references: [id], onDelete: SetNull)
  gateIds               Int[]            @default([])
  idCardUrl             String?
  declarationConfirmed  Boolean          @default(false)
  approvedByUserId      Int?
  approvedByUser        User?            @relation("ApprovedRequests", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt            DateTime?
  isEscalated           Boolean          @default(false)
  escalationReason      String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  // PME and RC Safety & Medical Qualifications
  pmeDate                 DateTime?
  pmeExpiryDate           DateTime?
  pmeCertificateNo        String?
  pmeCertificatePhotoUrl  String?
  rcDate                  DateTime?
  rcExpiryDate            DateTime?
  rcInstitute             String?
  rcCertificatePhotoUrl   String?

  @@index([status])
  @@index([zone, division])
  @@index([designation])
}

model LCGate {
  id               Int              @id @default(autoincrement())
  name             String?
  lcNumber         String           @unique
  locationName     String
  zone             String?
  division         String?
  stationId        Int?
  station          Station?         @relation(fields: [stationId], references: [id], onDelete: SetNull)
  latitude         Float?
  longitude        Float?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  masters          MasterUnit[]
  deviceRegistries DeviceRegistry[]
  events           LCGateEvent[]
  userGates        UserGate[]
  shiftConfigs     GateShiftConfig[]
  dutyRosters      GateDutyRoster[]
  shiftAttendances ShiftAttendance[]
}

model MasterUnit {
  id               Int                    @id @default(autoincrement())
  serialNumber     String                 @unique
  masterSequence   Int
  powerSource      String
  gateId           Int
  gate             LCGate                 @relation(fields: [gateId], references: [id], onDelete: Cascade)
  childDevices     ChildDevice[]
  evidences        InstallationEvidence[]
  deviceRegistry   DeviceRegistry?
  events           LCGateEvent[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model ChildDevice {
  id               Int                    @id @default(autoincrement())
  serialNumber     String                 @unique
  type             String
  deviceSequence   Int
  masterId         Int
  master           MasterUnit             @relation(fields: [masterId], references: [id], onDelete: Cascade)
  evidences        InstallationEvidence[]
  deviceRegistries DeviceRegistry[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model InstallationEvidence {
  id            Int          @id @default(autoincrement())
  category      String
  imageUrl      String
  latitude      Float?
  longitude     Float?
  userId        Int
  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  masterId      Int
  master        MasterUnit   @relation(fields: [masterId], references: [id], onDelete: Cascade)
  childDeviceId Int?
  childDevice   ChildDevice? @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model OtpVerification {
  id             Int      @id @default(autoincrement())
  identifier     String
  type           String // EMAIL or PHONE
  otp            String
  expiresAt      DateTime
  verified       Boolean  @default(false)
  failedAttempts Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([identifier, type])
}

model DeviceRegistry {
  id              Int          @id @default(autoincrement())
  thingName       String       @unique
  thingArn        String?
  thingTypeName   String?
  deviceType      String       @default("MASTER") // MASTER, SLAVE, SENSOR_UNIT, GATEWAY, etc.
  serialNumber       String?      @unique
  status             String       @default("ACTIVE") // Lifecycle only: ACTIVE, INACTIVE, PROVISIONED, DECOMMISSIONED, MAINTENANCE
  connectivityStatus String       @default("OFFLINE") // Hardware heartbeat: ONLINE, OFFLINE
  barrierState       String?      // Single source of truth from AWS IoT /telemetry: OPEN, CLOSED, or null (awaiting telemetry)
  lastTelemetryAt    DateTime?    // Timestamp of latest genuine /telemetry barrier packet
  lastTelemetryId    Int?         // DeviceTelemetry.id of latest barrier packet

  // Optional associations with LC Platform gate & units
  gateId             Int?
  gate               LCGate?      @relation(fields: [gateId], references: [id], onDelete: SetNull)
  masterId           Int?         @unique
  master             MasterUnit?  @relation(fields: [masterId], references: [id], onDelete: SetNull)
  childDeviceId   Int?
  childDevice     ChildDevice? @relation(fields: [childDeviceId], references: [id], onDelete: SetNull)

  // Hardware and manufacturing specifications
  macAddress      String?
  imei            String?
  firmwareVersion String?
  hardwareVersion String?
  dateOfMfg       DateTime?
  manufacturer    String?
  modelNumber     String?
  batchNumber     String?

  // SIM & Connectivity specifications
  simPhotoUrl         String?
  simProvider         String?      // Airtel, Jio, Vodafone Idea, BSNL, etc.
  simNumber           String?      // 10-digit mobile number
  iccid               String?      // Integrated Circuit Card Identifier
  simType             String?      // M2M, Regular, eSIM, etc.
  lastRechargeDate    DateTime?
  validityExpiryDate  DateTime?

  // Hardware device metadata requested
  sensors         Json?        // List or map of sensors within (e.g. solar voltage, inclinometer, radar, etc.)
  components      Json?        // List or map of internal hardware components (MCU, modem, relays, batteries)
  attributes      Json?        // AWS IoT Thing attributes
  metadata        Json?        // Additional custom specs or dynamic properties

  telemetries     DeviceTelemetry[]
  healthChecks    DeviceHealthCheck[]

  lastSeenAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([gateId])
  @@index([masterId])
  @@index([childDeviceId])
  @@index([status])
  @@index([connectivityStatus])
  @@index([barrierState])
}

model DeviceTelemetry {
  id               Int             @id @default(autoincrement())
  thingName        String
  topic            String?
  payload          Json
  status           String?
  receivedAt       DateTime        @default(now())
  deviceRegistryId Int?
  deviceRegistry   DeviceRegistry? @relation(fields: [deviceRegistryId], references: [id], onDelete: Cascade)

  @@index([thingName])
  @@index([receivedAt])
}

model DeviceHealthCheck {
  id                 Int             @id @default(autoincrement())
  thingName          String
  requestId          String?
  healthstatus       String?         // HEALTHY or DEGRADED when reported
  gateStatus         String?         // CLOSED or OPEN
  boomAngle          Float?
  mcuTempC           Float?
  signalStrength     Int?
  networkType        String?
  limitSwitchClosed  Boolean?
  hallClosed         Boolean?
  batteryVoltage     Float?
  batteryPercentage  Int?
  solarVoltage       Float?
  solarCharging      Boolean?
  uptimeSeconds      Int?
  firmwareVersion    String?
  rawPayload         Json
  deviceRegistryId   Int?
  deviceRegistry     DeviceRegistry? @relation(fields: [deviceRegistryId], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now())

  @@index([thingName])
  @@index([requestId])
  @@index([createdAt])
}

model GateStateAlertLog {
  id              Int      @id @default(autoincrement())
  gateId          Int?
  lcNumber        String
  status          String   // OPEN, CLOSED
  recipientMobile String
  recipientName   String?
  scopeGroupId    Int?
  message         String
  provider        String   // AIRTEL, 2FACTOR, SIMULATED
  statusResult    String   // SENT, FAILED, SKIPPED
  details         String?
  sentAt          DateTime @default(now())

  @@index([gateId])
  @@index([lcNumber])
  @@index([sentAt])
}

model LCGateEvent {
  id              Int         @id @default(autoincrement())
  gateId          Int
  gate            LCGate      @relation(fields: [gateId], references: [id], onDelete: Cascade)
  masterId        Int?
  master          MasterUnit? @relation(fields: [masterId], references: [id], onDelete: SetNull)
  masterSerial    String?
  thingName       String?
  openedAt        DateTime
  closedAt        DateTime?
  durationSeconds Int?        // Precomputed duration in seconds when closed
  status          String      @default("CLOSED") // OPEN, CLOSED, EXTENDED_DELAY
  openedBy        String?     // e.g., "Gatesman R. Sharma", "Station Master", "Interlock Auto"
  closedBy        String?
  trainNumber     String?     // e.g., "12952 Rajdhani Exp", "Freight DN-402", "Routine Road Clearance"
  remarks         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([gateId])
  @@index([gateId, masterId, status])
  @@index([openedAt])
  @@index([status])
}


model LCGateEventTombstone {
  id        BigInt   @id @default(autoincrement())
  eventId   Int
  gateId    Int
  openedAt  DateTime
  deletedAt DateTime @default(now())

  @@index([gateId, id])
  @@index([deletedAt])
}

model LCGateEventChangeLog {
  id              BigInt    @id @default(autoincrement())
  eventId         Int
  gateId          Int
  masterId        Int?
  masterSerial    String?
  thingName       String?
  opType          String    // INSERT, UPDATE, DELETE
  gateRevision    BigInt    // Transactionally serialized per-gate revision counter
  status          String?   // OPEN, CLOSED, EXTENDED_DELAY
  openedAt        DateTime?
  closedAt        DateTime?
  durationSeconds Int?
  openedBy        String?
  closedBy        String?
  trainNumber     String?
  remarks         String?
  createdAt       DateTime  @default(now())

  @@index([gateId, gateRevision])
  @@index([createdAt])
}

model Station {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  division  String
  zone      String
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gates                LCGate[]
  users                User[]
  registrationRequests RegistrationRequest[]
  shiftConfigs         GateShiftConfig[]
  dutyRosters          GateDutyRoster[]
  shiftAttendances     ShiftAttendance[]

  @@index([zone, division])
  @@index([code])
}

model UserGate {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gateId    Int
  gate      LCGate   @relation(fields: [gateId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, gateId])
  @@index([userId])
  @@index([gateId])
}

model GateShiftConfig {
  id          Int      @id @default(autoincrement())
  stationId   Int?
  station     Station? @relation(fields: [stationId], references: [id], onDelete: Cascade)
  gateId      Int?
  gate        LCGate?  @relation(fields: [gateId], references: [id], onDelete: Cascade)
  name        String   // "Standard 3-Shift 8hr", "2-Shift 12hr", "Custom"
  shiftsJson  String   // JSON array of [{ id, name, startTime, endTime }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([stationId])
  @@index([gateId])
}

model GateDutyRoster {
  id             Int       @id @default(autoincrement())
  gateId         Int
  gate           LCGate    @relation(fields: [gateId], references: [id], onDelete: Cascade)
  stationId      Int
  station        Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)
  date           String    // YYYY-MM-DD
  shiftName      String    // e.g. "Morning Shift"
  startTime      String    // "06:00"
  endTime        String    // "14:00"
  weekStartDate  String?   // e.g. "2026-11-09" (Week start date)
  dayOfWeek      String?   // "SUNDAY", "MONDAY", ..., "SATURDAY"
  shiftCode      String?   // "07-19", "19-24", "00-07", "W/R", "N/R", "-"
  isPermanent    Boolean   @default(false)
  isSplitShift   Boolean   @default(false)
  secondaryStart String?   // "19:00" for split night shifts
  secondaryEnd   String?   // "24:00"
  gatemanUserId  Int
  gateman        User      @relation("AssignedGateman", fields: [gatemanUserId], references: [id], onDelete: Cascade)
  createdById    Int
  createdBy      User      @relation("RosterCreator", fields: [createdById], references: [id], onDelete: Cascade)
  notifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  shiftAttendances ShiftAttendance[]

  @@unique([gateId, date, shiftName])
  @@index([stationId, date])
  @@index([gatemanUserId])
  @@index([gateId, isPermanent, dayOfWeek])
  @@index([gatemanUserId, isPermanent, dayOfWeek])
}

model ShiftAttendance {
  id               Int             @id @default(autoincrement())
  userId           Int
  user             User            @relation("UserAttendances", fields: [userId], references: [id], onDelete: Cascade)
  rosterId         Int?
  roster           GateDutyRoster? @relation(fields: [rosterId], references: [id], onDelete: SetNull)
  gateId           Int?
  gate             LCGate?         @relation(fields: [gateId], references: [id], onDelete: SetNull)
  stationId        Int
  station          Station         @relation(fields: [stationId], references: [id], onDelete: Cascade)
  date             String          // YYYY-MM-DD
  shiftName        String          // e.g. "Morning Shift (06:00 - 14:00)"
  type             String          // "CHECK_IN" or "CHECK_OUT"
  timestamp        DateTime        @default(now())

  // Geofence audit
  latitude         Float
  longitude        Float
  distanceMeters   Float           // Computed distance from target gate or station
  geofencePassed   Boolean         @default(false)

  // Biometric audit
  similarityScore  Float?          // e.g. 98.6%
  livenessPassed   Boolean         @default(true)
  selfieUrl        String?         // Audit thumbnail or file path

  // Shift compliance status
  status           String          @default("PRESENT") // PRESENT, LATE, EARLY_LEAVING, OVERTIME, MANUAL_PENDING, MANUAL_APPROVED, REJECTED
  minutesLate      Int             @default(0)

  // Fallback audit
  isManualFallback Boolean         @default(false)
  fallbackReason   String?
  approvedById     Int?
  approvedBy       User?           @relation("AttendanceApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt       DateTime?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId, date])
  @@index([gateId, date])
  @@index([stationId, date])
}

model FaceReenrollmentRequest {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation("UserReenrollments", fields: [userId], references: [id], onDelete: Cascade)
  reason         String    // e.g. "Facial injury / surgery", "Camera quality issue", "Appearance update"
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedAt    DateTime  @default(now())
  reviewedById   Int?
  reviewedBy     User?     @relation("ReenrollmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  rejectionNotes String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

